{
  "name": "nfr",
  "private": true,
  "type": "module",
  "scripts": {
    "test:e2e": "vitest run --project=e2e",
    "test:e2e:ui": "vitest --ui --watch --open --project=e2e",
    "test:load": "vitest run --project=load",
    "test:lh": "node lighthouse/run.ts",
    "test": "node --import=amaro/transform --test profile/*.test.ts",
    "test:profile": "node --env-file-if-exists=../../.env profile/run.ts",
    "test:profile:api": "node --env-file-if-exists=../../.env profile/api.ts",
    "test:profile:web": "node --env-file-if-exists=../../.env profile/web.ts"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@vitest/ui": "5.1.0",
    "autocannon": "^9.0.0",
    "lighthouse": "^13.6.0",
    "playwright": "^1.65.0",
    "types": "workspace:*",
    "api": "workspace:*",
    "amaro": "^1.3.0",
    "zod": "^4.6.7"
  }
}
