{
  "rewrites": [
    { "source": "/env", "destination": "/env.json" },
    { "source": "**/!(env.json)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "**", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    {
      "source": "assets/*-*.@(js|css)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    { "source": "index.html", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "env.json", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
