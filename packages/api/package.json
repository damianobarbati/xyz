{
  "name": "api",
  "type": "module",
  "imports": {
    "#api/*": "./src/*",
    "#api-database/*": "./database/*"
  },
  "scripts": {
    "test": "vitest run",
    "start:dev": "NODE_ENV=development DEBUG=${DEBUG:-'xyz:*'} node --no-warnings --env-file-if-exists=../../.env --watch ./src/index.ts",
    "start": "NODE_ENV=production DEBUG=${DEBUG:-'xyz:*'} node --no-warnings ./src/index.ts",
    "db:migrate:make": "NODE_ENV=development NODE_OPTIONS='--no-warnings' knex migrate:make --knexfile=./src/database/config.ts",
    "db:migrate": "NODE_ENV=development NODE_OPTIONS='--no-warnings' knex migrate:latest --knexfile=./src/database/config.ts",
    "db:seed:make": "NODE_ENV=development NODE_OPTIONS='--no-warnings' knex seed:make --knexfile=./src/database/config.ts",
    "db:seed": "NODE_ENV=development DEBUG='atlas:seed' NODE_OPTIONS='--no-warnings' knex seed:run --knexfile=./src/database/config.ts"
  },
  "dependencies": {
    "@faker-js/faker": "^10.4.0",
    "@hono/node-server": "^2.0.1",
    "debug": "^4.4.3",
    "hono": "^4.12.27",
    "ioredis": "^5.10.1",
    "knex": "^3.2.10",
    "pg": "^8.20.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "types": "workspace:^"
  }
}
