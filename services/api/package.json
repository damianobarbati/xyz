{
  "name": "api",
  "type": "module",
  "imports": {
    "#api/*": "./src/*",
    "#api/helper/*": "./src/helper/*"
  },
  "scripts": {
    "test": "vitest run",
    "test:native": "node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info",
    "start": "NODE_ENV=development DEBUG=${DEBUG:-'xyz:*'} node --no-warnings --env-file-if-exists=../../.env --watch ./src/index.ts",
    "db:migrate:make": "NODE_ENV=development NODE_OPTIONS='--no-warnings' knex migrate:make --knexfile=./src/database/config.ts",
    "db:migrate": "NODE_ENV=development NODE_OPTIONS='--no-warnings' knex migrate:latest --knexfile=./src/database/config.ts",
    "db:seed:make": "NODE_ENV=development NODE_OPTIONS='--no-warnings' knex seed:make --knexfile=./src/database/config.ts",
    "db:seed": "NODE_ENV=development DEBUG='atlas:seed' NODE_OPTIONS='--no-warnings' knex seed:run --knexfile=./src/database/config.ts"
  },
  "dependencies": {
    "@faker-js/faker": "^10.3.0",
    "@hono/node-server": "^1.19.11",
    "debug": "^4.4.3",
    "hono": "^4.12.8",
    "ioredis": "^5.10.0",
    "knex": "^3.1.0",
    "pg": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "types": "workspace:^"
  }
}
